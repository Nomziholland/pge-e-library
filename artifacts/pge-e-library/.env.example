# Copy this file to .env and fill in real values. Never commit .env.

# Full URL of the deployed API server (Render), e.g.
# https://pge-e-library-api.onrender.com
# Leave unset for local dev if you're proxying /api to a local server.
VITE_API_BASE_URL=

# Vite requires these to be set. Vercel serves the frontend from the
# domain root, so BASE_PATH should be "/". PORT is only used by the
# local dev server; Vercel ignores it.
PORT=5173
BASE_PATH=/
